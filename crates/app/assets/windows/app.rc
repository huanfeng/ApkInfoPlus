// Windows 资源：exe 图标（资源管理器 / 任务栏用）+ 版本信息。由 build.rs 编译并链接。
// 常量按 winver.h 手写，不 include：交叉编译时 llvm-rc 未必找得到 SDK 头文件。
#define VS_VERSION_INFO 1
#define VS_FFI_FILEFLAGSMASK 0x3FL
#define VOS__WINDOWS32 0x4L
#define VFT_APP 0x1L
#define VFT2_UNKNOWN 0x0L

1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,3,0,0
PRODUCTVERSION  0,3,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "APK Info Plus"
            VALUE "FileVersion", "0.3.0"
            VALUE "InternalName", "apkinfoplus"
            VALUE "OriginalFilename", "apkinfoplus.exe"
            VALUE "ProductName", "APK Info Plus"
            VALUE "ProductVersion", "0.3.0"
            VALUE "LegalCopyright", "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
